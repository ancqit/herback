# Copy to .env for local runs. Never commit .env.
# Render: set the same names under the herback service → Environment.
# Leave a value blank only when the comment says it is optional.

# Atlas → Connect → Drivers → Python. Paste the mongodb+srv URL.
# Replace <password>. Encode @ : / # ? in the password as %40 %3A %2F %23 %3F.
# Same variable junctionBack uses. Database defaults to herb, not junction.
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=herback
MONGODB_DATABASE=herb
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_POOL_SIZE=100

# Cloudflare account id (R2 overview page, or the subdomain of the S3 endpoint).
R2_ACCOUNT_ID=
# R2 API token → Access Key ID. Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
# R2 API token → Secret Access Key. Shown once when the token is created.
R2_SECRET_ACCESS_KEY=
# Bucket name, not the public hostname. Example: herb-media
R2_BUCKET=herb-media
# Public read base. Custom domain or the r2.dev URL, no trailing path.
# Example: https://media.herbant.example
R2_PUBLIC_BASE_URL=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional. Presign lifetime in seconds (default 600).
# R2_SIGN_EXPIRES_SECONDS=600
# Optional. Cache-Control on server-side uploads (POST /media).
# R2_CACHE_CONTROL=public, max-age=31536000, immutable

# Desk password for the scrap portal. 2001 stays the read-only login. Not an R2 key.
# UPLOAD_TOKEN=

# Shared secret for POST /media/sign, POST /media, and DELETE /media.
# Generate with: openssl rand -hex 32
# Sent as header X-Herb-Key, or Authorization: Bearer <key>.
HERB_API_KEY=

# Optional extra browser origins, comma-separated. Merged with the built-in
# list (localhost:4200, https://herbant.vercel.app, and https://scrap-sooty.vercel.app).
# CORS_ORIGINS=https://my-preview.vercel.app
# Optional. Empty string turns the preview regex off.
# CORS_ORIGIN_REGEX=
# Set to false in production once you no longer want /docs.
# OPENAPI_ENABLED=true
